--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -124,6 +124,18 @@
 	void present(const uint8_t *rec);
 };
 
+/*
+ * PD2049: publish an empty IOAcceleratorES so QuartzCore does not poll
+ * IOServiceMatching("IOAcceleratorES") for 30 seconds at every backboardd
+ * start. It has no MetalPluginName/MetalPluginClassName, so Metal skips it;
+ * the CPU/GL renderer selection stays unchanged.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
 class IOMobileFramebufferUserClient : public IOUserClient {
@@ -201,6 +213,16 @@
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
 	registerService();
+
+	uint32_t accelOn = 1;
+	(void)PE_parse_boot_argn("sweetaccel", &accelOn, sizeof(accelOn));
+	IOAcceleratorES *accel = accelOn ? OSTypeAlloc(IOAcceleratorES) : NULL;
+	if (accel != NULL && accel->init()) {
+		accel->setName("sgx");
+		if (accel->attach(this))
+			accel->registerService();
+	}
+	OSSafeReleaseNULL(accel);
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
