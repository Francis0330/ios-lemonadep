 	sweet_early_mark(1, "arm_init entered (MMU on)");
 
+#if defined(SWEET)
+	/*
+	 * PD2049: Gunyah re-arms its watchdog when the VM enters XNU.
+	 * Disable it again from kernel context (enable, 32 s, ping, disable).
+	 */
+	{
+		register uint64_t x0 __asm__("x0");
+		register uint64_t x1 __asm__("x1");
+		register uint64_t x2 __asm__("x2");
+		register uint64_t x3 __asm__("x3");
+
+		x0 = 0x86000005ULL; x1 = 3; x2 = 0; x3 = 0;
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+		x0 = 0x86000008ULL; x1 = 32000; x2 = 32000; x3 = 0;
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+		x0 = 0x86000007ULL; x1 = 0; x2 = 0; x3 = 0;
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+		x0 = 0x86000005ULL; x1 = 2; x2 = 0; x3 = 0;
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+	}
+#endif
